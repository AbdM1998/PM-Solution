# Copy this file to .env (git-ignored, see repo root .gitignore) and adjust if needed.
# Expo automatically exposes any EXPO_PUBLIC_* variable to client code at build time —
# no extra config required. This must point at the same apps/api server documented in
# docs/API_DESIGN.md / the repo root .env.example.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
