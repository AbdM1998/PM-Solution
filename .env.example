# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
POSTGRES_USER=projectflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=projectflow
DATABASE_URL=postgresql://projectflow:change-me-locally@localhost:5432/projectflow

# --- API ---
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
WEB_ORIGIN=http://localhost:3000
MOBILE_ORIGIN=http://localhost:19006
STORAGE_ROOT=./storage
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Worker ---
WORKER_TICK_SECONDS=30
WORKER_BATCH_SIZE=50
DISPATCHER_TICK_SECONDS=10
STALE_AFTER_HOURS=24

# --- Email (In-App + SMTP channel). Leave blank to log instead of sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ProjectFlow <no-reply@example.com>

# --- Microsoft Graph (Outlook/365) — optional, needed only to go live ---
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --- Gmail API — optional, needed only to go live ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/email-connections/gmail/callback

# --- WhatsApp Business Cloud API — optional, needed only to go live ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Web app ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# --- Mobile app (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
