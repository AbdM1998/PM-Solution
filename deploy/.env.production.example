# ProjectFlow production settings. Copy to the repo root as `.env` on the server:
#   cp deploy/.env.production.example .env && nano .env
# NEVER commit the real .env. Generate secrets with:  openssl rand -base64 48

# ---- Your domain (no trailing slash) ----
WEB_ORIGIN=https://projectflow.example.com
MOBILE_ORIGIN=https://projectflow.example.com

# ---- Database (internal to Docker — never exposed to the internet) ----
POSTGRES_USER=projectflow
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=projectflow

# ---- Secrets (generate each one: openssl rand -base64 48 / openssl rand -base64 32) ----
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- The single administrator account ----
# Created automatically on first start (and re-promoted to admin if it already exists).
# After you log in once, you can change the password from Admin → Users.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=Administrator
# false = nobody can sign up on their own; the admin creates every account (Admin → Users).
ALLOW_REGISTRATION=false

# ---- Email (SMTP) — reminders by email ----
# GoDaddy Professional Email / Microsoft 365:  smtp.office365.com : 587
# GoDaddy Workspace Email:                     smtpout.secureserver.net : 465
# Gmail (needs a Google "App password"):       smtp.gmail.com : 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ProjectFlow <no-reply@example.com>

# ---- WhatsApp Business Cloud API (Meta) — reminders by WhatsApp ----
# From developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Reminders are business-initiated, so Meta requires an APPROVED template. Create one
# (category "Utility") whose body has two variables, e.g.:
#   "🔔 {{1}}\n{{2}}"
# and put its name + language code here. Leave empty to send plain text (Meta only
# delivers that within 24h of the recipient messaging your number).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar

# ---- Reminder engine tuning (defaults are fine) ----
WORKER_TICK_SECONDS=30
WORKER_BATCH_SIZE=50
DISPATCHER_TICK_SECONDS=10
STALE_AFTER_HOURS=24
